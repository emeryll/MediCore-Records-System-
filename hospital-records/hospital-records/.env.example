# -----------------------------------------------------------------------------
# West Metro Medical Center - Environment Configuration (.env)
# -----------------------------------------------------------------------------
# Copy this file to .env or set these environment variables in your server/hosting.
# Credentials are read directly from environment variables.

# SMTP Email Configuration (Used for Account Activation & Password Setup)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_AUTH=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_google_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="West Metro Medical Center"

# Database Configuration (Defaults to 127.0.0.1:3306 MySQL or SQLite fallback)
# MEDICORE_DB_HOST=127.0.0.1
# MEDICORE_DB_PORT=3306
# MEDICORE_DB_USER=root
# MEDICORE_DB_PASS=
# MEDICORE_DB_NAME=medicore_records
